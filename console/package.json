{
  "name": "slopbot-console",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6106 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "dev:mock": "VITE_MOCK_API=1 vite",
    "test:stories": "vitest run --project \"storybook-*\""
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@slopbot/contracts": "workspace:*",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-router": "1.170.46",
    "agentic-ui-kit": "catalog:",
    "lucide-react": "1.69.0",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "slop-ui-components": "github:bushshrub/slop-ui-components#v0.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "msw": "^3.0.4",
    "msw-storybook-addon": "^3.0.3",
    "playwright": "^1.65.0",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "src/mocks/public"
    ]
  }
}
