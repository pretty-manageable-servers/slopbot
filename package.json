{
  "name": "slopbot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/adapters/postgres-schema.sql dist/src/adapters/postgres-schema.sql && mkdir -p dist/architecture && cp architecture/BOT_GUIDE.md dist/architecture/BOT_GUIDE.md",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js && node --test scripts/deployment/*.test.mjs && node --test scripts/development/error-regressions.test.mjs",
    "start": "npm run dev",
    "demo": "npm run build && node dist/src/main.js",
    "models": "npm run build && node --env-file-if-exists=.env dist/src/list-models.js",
    "search:start": "node scripts/search-start.mjs",
    "search:stop": "docker compose -f compose.search.yaml down",
    "dev": "node scripts/development/start.mjs",
    "sandbox:smoke": "npm run build && node --env-file-if-exists=.env.development scripts/sandbox-smoke.mjs",
    "regression:audit": "npm run build && node --test scripts/development/error-regressions.test.mjs",
    "storage:smoke": "npm run build && node --env-file-if-exists=.env.development scripts/storage-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "discord.js": "^14.27.0",
    "e2b": "^2.55.0",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "undici": "^7.30.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
