# Separate Discord application. Never paste the production token here.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=
LLM_MODE=provider
LLM_BASE_URL=https://api.pmservers.org/ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash-next
CONTEXT_TOKENS=131072
OUTPUT_TOKENS=65536
CHECKPOINT_TOKENS=2048
EMBEDDING_MODEL=llama.cpp/embeddinggemma-2
JEV_MODEL=kev
# Secure shared-service connection setup is pending.
# Use a dedicated dev database/user, never production tables.
DATABASE_SCHEMA=slopbot_dev
DATABASE_URL=
SEARXNG_URL=
DATABASE_PATH=data/development/slopbot.sqlite3

# Optional PMServers remote sandbox. Use a project token, not the AI key.
E2B_API_KEY=
E2B_API_URL=https://api.pmservers.org/sandboxes
E2B_SANDBOX_URL=https://sandbox.pmservers.org
# E2B_TEMPLATE=base

# Managed private database tunnel for npm run dev. Set DATABASE_URL to localhost:15432.
PMS_DB_TUNNEL=false
PMS_CLI_PATH=.tools/pms-v0.7.0/pms
PMS_DB_ID=slopbot
PMS_PROJECT=slop
PMS_DB_PORT=15432
PMS_SSH_KEY=data/deployment/database-tunnel-key

# Optional protected HTTPS search endpoint. Both values are required together.
SEARXNG_ACCESS_CLIENT_ID=
SEARXNG_ACCESS_CLIENT_SECRET=
