DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional initial parent channel IDs; /slopbot channels can configure these later.
DISCORD_CHANNEL_IDS=

# Start with mock to test Discord without an AI API key.
LLM_MODE=mock
LLM_BASE_URL=https://api.pmservers.org/ai/v1
LLM_API_KEY=
LLM_MODEL=nimbus
DATABASE_PATH=./data/slopbot.sqlite3
JEV_ENABLED=true
JEV_MODEL=vane
JEV_CONTEXT_MESSAGES=8
REPLY_CONTEXT_MESSAGES=12
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=llama.cpp/embeddinggemma-2

JEV_COOLDOWN_SECONDS=60
JEV_MAX_REPLIES_PER_HOUR=3

# Initial history coverage; imported older text is retained
HISTORY_WINDOW_DAYS=7

# Model defaults: nimbus 200K context / 50K output; cirrus 64K / 32K.
# Optional overrides must fit the documented model limits.
# CONTEXT_TOKENS=200000
# OUTPUT_TOKENS=50000
CHECKPOINT_TOKENS=2048
# Maximum model/tool rounds per attempt; retries receive a fresh allowance.
MAX_TOOL_ROUNDS=64

# Optional SearXNG instance; JSON format must be enabled.
# SEARXNG_URL=http://127.0.0.1:8080

# Set for managed Postgres; otherwise DATABASE_PATH uses local SQLite.
DATABASE_URL=
## Optional web configuration console. Register WEB_ORIGIN/auth/callback in Discord OAuth2.
WEB_ENABLED=false
WEB_ORIGIN=http://localhost:3000
WEB_HOST=127.0.0.1
WEB_PORT=3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Runtime MCP credentials are encrypted with this operator-managed key.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the key stable across restarts. Anonymous MCP endpoints need no key.
MCP_SECRET_KEY=
# Private/local endpoints are blocked unless the operator explicitly allows them.
MCP_ALLOW_PRIVATE=false

# Optional PMServers remote sandbox. Use a project token, not the AI key.
E2B_API_KEY=
E2B_API_URL=https://api.pmservers.org/sandboxes
E2B_SANDBOX_URL=https://sandbox.pmservers.org
# Default existing PMServers template; calls can override with template:name or name:tag.
# E2B_TEMPLATE=base

# Optional protected HTTPS search endpoint. Both values are required together.
SEARXNG_ACCESS_CLIENT_ID=
SEARXNG_ACCESS_CLIENT_SECRET=

# Optional persistent files. Create one dedicated bucket and a bucket-scoped read/write S3 key.
OBJECT_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=pms
AWS_ENDPOINT_URL=https://s3.pmservers.org
# In PMServers containers, AWS_ENDPOINT_URL can be http://garage.pms-storage.svc:3900.
# Download links always use the public HTTPS endpoint.
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.pmservers.org
