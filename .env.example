DISCORD_BOT_TOKEN=
# Optional comma-separated server IDs that Slopbot may join. Empty allows every server that invites it.
DISCORD_GUILD_IDS=
# Optional initial parent channel IDs in the server DISCORD_GUILD_ID; /slopbot channels can configure these later.
DISCORD_GUILD_ID=
DISCORD_CHANNEL_IDS=

# Start with mock to test Discord without an AI API key.
LLM_MODE=mock
LLM_BASE_URL=https://api.pmservers.org/ai/v1
VOICE_ENABLED=true
# Thunder voice name. The AI key needs squall and thunder access.
VOICE_NAME=alloy
LLM_API_KEY=
LLM_MODEL=nimbus
DATABASE_PATH=./data/slopbot.sqlite3
JEV_ENABLED=true
JEV_MODEL=vane
# Native decision score cutoffs, 0 to 1. Server calibration settings override these.
JEV_ADDRESSED_THRESHOLD=0.65
JEV_RESPONSE_THRESHOLD=0.5
JEV_UNSOLICITED_THRESHOLD=0.9
JEV_FUNNY_THRESHOLD=0.9
JEV_CONTEXT_MESSAGES=8
REPLY_CONTEXT_MESSAGES=12
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=llama.cpp/embeddinggemma-2

JEV_COOLDOWN_SECONDS=60
JEV_MAX_REPLIES_PER_HOUR=3

# Initial history coverage; imported older text is retained
HISTORY_WINDOW_DAYS=7
# Web transcript stream events (text and thinking deltas) older than this, and rows beyond the cap, are pruned hourly.
CONVERSATION_EVENTS_RETENTION_DAYS=14
CONVERSATION_EVENTS_MAX_ROWS=2000000

# Model defaults: nimbus 200K context / 50K output; cirrus 64K / 32K.
# Optional overrides must fit the documented model limits.
# CONTEXT_TOKENS=200000
# OUTPUT_TOKENS=50000
CHECKPOINT_TOKENS=2048
# Maximum model/tool rounds per execution attempt; retries receive a fresh allowance.
MAX_TOOL_ROUNDS=64

# Optional SearXNG instance; JSON format must be enabled.
# SEARXNG_URL=http://127.0.0.1:8080
# Seals Tavily and Firecrawl keys that team members add in the admin panel.
# 32 random bytes, base64: openssl rand -base64 32. Without it, only SearXNG and plain fetch run.
WEB_KEYS_SECRET=

# Set for managed Postgres; otherwise DATABASE_PATH uses local SQLite.
DATABASE_URL=
## Optional web configuration console. Register WEB_ORIGIN/auth/callback in Discord OAuth2.
WEB_ENABLED=false
WEB_ORIGIN=http://localhost:3000
WEB_HOST=127.0.0.1
WEB_PORT=3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Runtime MCP credentials are encrypted with this operator-managed key.
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the key stable across restarts. Anonymous MCP endpoints need no key.
MCP_SECRET_KEY=
# Private/local endpoints are blocked unless the operator explicitly allows them.
MCP_ALLOW_PRIVATE=false

# Optional investigation, GitHub issue reporting and fix tracking. Explicit server allowlist.
# Other servers never receive these operational tools. Repository/infrastructure access is admin-only.
SLOPBOT_OPERATIONS_GUILD_IDS=
SLOPBOT_GITHUB_REPOSITORY=pretty-manageable-servers/slopbot
# Dedicated repository-scoped credential: Contents/Actions/Pull requests read; Issues write.
# Use a fine-grained token, or an externally refreshed GitHub App installation token.
SLOPBOT_GITHUB_TOKEN=
# Dedicated PMServers project token, separate from the CI deployment credential.
# The bot adapter only sends GET requests. The provider token itself may permit broader actions.
SLOPBOT_PMS_TOKEN=
SLOPBOT_PMS_PROJECT_ID=
# Container names or IDs; first entry is Slopbot itself, remaining entries are dependencies.
SLOPBOT_PMS_CONTAINERS=slopbot

# Optional PMServers remote sandbox. Use a project token, not the AI key.
E2B_API_KEY=
E2B_API_URL=https://api.pmservers.org/sandboxes
E2B_SANDBOX_URL=https://sandbox.pmservers.org
# Default existing PMServers template; calls can override with template:name or name:tag.
# E2B_TEMPLATE=base

# Optional protected HTTPS search endpoint. Both values are required together.
SEARXNG_ACCESS_CLIENT_ID=
SEARXNG_ACCESS_CLIENT_SECRET=

# Optional persistent files. Create one dedicated bucket and a bucket-scoped read/write S3 key.
OBJECT_STORAGE_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=pms
AWS_ENDPOINT_URL=https://s3.pmservers.org
# In PMServers containers, AWS_ENDPOINT_URL can be http://garage.pms-storage.svc:3900.
# Download links always use the public HTTPS endpoint.
OBJECT_STORAGE_PUBLIC_ENDPOINT=https://s3.pmservers.org
