DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional initial parent channel IDs; /slopbot channels can configure these later.
DISCORD_CHANNEL_IDS=

# Start with mock to test Discord without an AI API key.
LLM_MODE=mock
LLM_BASE_URL=https://api.pmservers.org/ai/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash-next
DATABASE_PATH=./data/slopbot.sqlite3
JEV_ENABLED=true
JEV_MODEL=typesafe/kev-4b
JEV_CONTEXT_MESSAGES=8
REPLY_CONTEXT_MESSAGES=12
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=llama.cpp/embeddinggemma-2

JEV_COOLDOWN_SECONDS=60
JEV_MAX_REPLIES_PER_HOUR=3

# Initial history coverage; imported older text is retained
HISTORY_WINDOW_DAYS=7

# Conservative prompt budget, including reserved output. Adjust to the model limit.
CONTEXT_TOKENS=32768
OUTPUT_TOKENS=2048
CHECKPOINT_TOKENS=2048

# Optional SearXNG instance; JSON format must be enabled.
# SEARXNG_URL=http://127.0.0.1:8080

# Set for managed Postgres; otherwise DATABASE_PATH uses local SQLite.
DATABASE_URL=
## Optional web configuration console. Register WEB_ORIGIN/auth/callback in Discord OAuth2.
WEB_ENABLED=false
WEB_ORIGIN=http://localhost:3000
WEB_HOST=127.0.0.1
WEB_PORT=3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional PMServers remote sandbox. Use a project token, not the AI key.
E2B_API_KEY=
E2B_API_URL=https://api.pmservers.org/sandboxes
E2B_SANDBOX_URL=https://sandbox.pmservers.org
# E2B_TEMPLATE=base

# Optional protected HTTPS search endpoint. Both values are required together.
SEARXNG_ACCESS_CLIENT_ID=
SEARXNG_ACCESS_CLIENT_SECRET=
