# Local console (no Discord). Copy to .env.web, set LLM_API_KEY, then run pnpm dev:web.

# Runs the console on the local platform: no Discord login, no Discord servers.
SLOPBOT_PLATFORM=local
# Local Postgres from compose.development.yaml. start-web refuses any other host.
DATABASE_URL=postgres://slopbot:local-development-only@127.0.0.1:5433/slopbot
# Schema for this local world. Keeps its tables apart from the Discord dev schema (slopbot_dev).
DATABASE_SCHEMA=slopbot_local
# OpenAI-compatible endpoint that answers chat requests.
LLM_BASE_URL=https://api.pmservers.org/ai/v1
# Key for LLM_BASE_URL. Leave empty only with LLM_MODE=mock.
LLM_API_KEY=
# Model name sent to LLM_BASE_URL.
LLM_MODEL=nimbus
# Serves the web console.
WEB_ENABLED=true
# Address the console is opened on in the browser.
WEB_ORIGIN=http://localhost:3000
# Stand-in for Discord sign-in (scripts/development/dev-oauth.mjs). Local development only.
WEB_OAUTH_BASE=http://127.0.0.1:9091
# Fixture world: the bot, servers and users. The sign-in page offers its users as buttons.
LOCAL_WORLD=dev/local-world.json
# Local SearXNG from compose.development.yaml, used by web search.
SEARXNG_URL=http://127.0.0.1:8080
